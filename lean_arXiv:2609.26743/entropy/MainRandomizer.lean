import Mathlib.NumberTheory.LegendreSymbol.AddCharacter
import Mathlib.Algebra.Polynomial.Roots
import Mathlib.Analysis.InnerProductSpace.PiL2
import Mathlib.Tactic

/-! The finite-field character estimate used in the explicit Pauli randomizer.
Every average below is the actual finite uniform average. -/

noncomputable section
open scoped BigOperators

namespace MainRandomizer

def binarySign : AddChar (ZMod 2) ℝ :=
  AddChar.zmodChar 2 (ζ := (-1 : ℝ)) (by norm_num)

@[simp] theorem binarySign_eq_one_iff (a : ZMod 2) :
    binarySign a = 1 ↔ a = 0 := by
  exact AddChar.IsPrimitive.zmod_char_eq_one_iff 2
    (AddChar.zmodChar_primitive_of_primitive_root 2
      (IsPrimitiveRoot.neg_one 0 (by norm_num))) a

variable (F : Type*) [Field F] [Fintype F] [DecidableEq F] [Algebra (ZMod 2) F]

/-- The sign of the binary field trace, exactly as in the construction. -/
def traceSign : AddChar F ℝ :=
  binarySign.compAddMonoidHom (Algebra.trace (ZMod 2) F).toAddMonoidHom

@[simp] theorem traceSign_apply (x : F) :
    traceSign F x = binarySign (Algebra.trace (ZMod 2) F x) := rfl

theorem traceSign_ne_one : traceSign F ≠ 1 := by
  have htrace := (traceForm_nondegenerate (ZMod 2) F).1 (1 : F)
  simp only [Algebra.traceForm_apply, one_mul] at htrace
  obtain ⟨x, hx⟩ : ∃ x : F, Algebra.trace (ZMod 2) F x ≠ 0 := by
    by_contra! h
    exact one_ne_zero (htrace h)
  exact AddChar.ne_one_iff.mpr ⟨x, by simpa using hx⟩

theorem traceSign_primitive : (traceSign F).IsPrimitive :=
  AddChar.IsPrimitive.of_ne_one (traceSign_ne_one F)

theorem trace_character_average (z : F) :
    ∑ y : F, traceSign F (y * z) =
      if z = 0 then (Fintype.card F : ℝ) else 0 := by
  classical
  simpa only [Nat.cast_ite, Nat.cast_zero] using
    AddChar.sum_mulShift z (traceSign_primitive F)

def polynomialBias (p : Polynomial F) : ℝ :=
  (Fintype.card F : ℝ)⁻¹ ^ 2 *
    ∑ x : F, ∑ y : F, traceSign F (y * p.eval x)

theorem polynomialBias_eq_root_count (p : Polynomial F) :
    polynomialBias F p =
      ((Finset.univ.filter fun x : F => p.eval x = 0).card : ℝ) /
        (Fintype.card F : ℝ) := by
  classical
  have hc : (Fintype.card F : ℝ) ≠ 0 := by
    exact_mod_cast Fintype.card_ne_zero
  unfold polynomialBias
  simp_rw [trace_character_average]
  rw [← Finset.sum_filter]
  simp only [Finset.sum_const, nsmul_eq_mul]
  field_simp

theorem polynomial_root_count_le (p : Polynomial F) (hp : p ≠ 0) :
    (Finset.univ.filter fun x : F => p.eval x = 0).card ≤ p.natDegree := by
  classical
  have heq : (Finset.univ.filter fun x : F => p.eval x = 0) = p.roots.toFinset := by
    ext x
    simp [Polynomial.mem_roots hp, Polynomial.IsRoot.def]
  rw [heq]
  exact (Multiset.toFinset_card_le _).trans (Polynomial.card_roots' p)

/-- A nonzero degree-d polynomial gives bias at most d divided by the field size. -/
theorem polynomialBias_bounds (p : Polynomial F) (hp : p ≠ 0) :
    0 ≤ polynomialBias F p ∧
      polynomialBias F p ≤ (p.natDegree : ℝ) / Fintype.card F := by
  rw [polynomialBias_eq_root_count]
  constructor
  · positivity
  · apply div_le_div_of_nonneg_right _ (by positivity)
    exact_mod_cast polynomial_root_count_le F p hp

/-- Polynomial whose coefficients are the prescribed binary label. -/
def labelPolynomial {n : ℕ} (b : Fin n → ZMod 2) : Polynomial F :=
  ∑ j, Polynomial.monomial j.val (algebraMap (ZMod 2) F (b j))

@[simp] theorem labelPolynomial_coeff {n : ℕ} (b : Fin n → ZMod 2) (j : Fin n) :
    (labelPolynomial F b).coeff j.val = algebraMap (ZMod 2) F (b j) := by
  classical
  simp [labelPolynomial, Polynomial.finset_sum_coeff, Polynomial.coeff_monomial,
    Fin.val_inj]

theorem labelPolynomial_ne_zero {n : ℕ} (b : Fin n → ZMod 2) (hb : b ≠ 0) :
    labelPolynomial F b ≠ 0 := by
  intro hp
  apply hb
  funext j
  have hj := congrArg (fun p : Polynomial F => p.coeff j.val) hp
  simpa using hj

theorem labelPolynomial_degree_le {n : ℕ} (b : Fin n → ZMod 2) :
    (labelPolynomial F b).natDegree ≤ n - 1 := by
  apply Polynomial.natDegree_sum_le_of_forall_le
  intro j _
  exact (Polynomial.natDegree_monomial_le _).trans (Nat.le_sub_one_of_lt j.isLt)

/-- The explicit length-n binary word generated by the seed (x,y). -/
def codeword {n : ℕ} (x y : F) : Fin n → ZMod 2 :=
  fun j => Algebra.trace (ZMod 2) F (y * x ^ j.val)

theorem codeword_character {n : ℕ} (b : Fin n → ZMod 2) (x y : F) :
    MainRandomizer.binarySign (∑ j, b j * codeword F x y j) =
      traceSign F (y * (labelPolynomial F b).eval x) := by
  unfold labelPolynomial
  simp only [Polynomial.eval_finset_sum, Polynomial.eval_monomial,
    Finset.mul_sum, traceSign_apply, map_sum, codeword]
  congr 1
  apply Finset.sum_congr rfl
  intro j _
  rw [mul_left_comm y, ← Algebra.smul_def, map_smul]
  rfl

/-- Every nontrivial binary parity of the generated words has the stated bias. -/
theorem codeword_bias_bound {n : ℕ} (b : Fin n → ZMod 2) (hb : b ≠ 0) :
    0 ≤ (Fintype.card F : ℝ)⁻¹ ^ 2 *
      ∑ x : F, ∑ y : F, binarySign (∑ j, b j * codeword F x y j) ∧
    (Fintype.card F : ℝ)⁻¹ ^ 2 *
      ∑ x : F, ∑ y : F, binarySign (∑ j, b j * codeword F x y j) ≤
        ((n - 1 : ℕ) : ℝ) / Fintype.card F := by
  simp_rw [codeword_character]
  have h := polynomialBias_bounds F (labelPolynomial F b) (labelPolynomial_ne_zero F b hb)
  refine ⟨h.1, h.2.trans ?_⟩
  apply div_le_div_of_nonneg_right _ (by positivity)
  exact_mod_cast labelPolynomial_degree_le F b

/-- The elementary Parseval step: a diagonal multiplier contracts the sum of
squared coefficients by the square of its largest multiplier. -/
theorem coefficient_contraction {ι : Type*} [Fintype ι]
    (lam : ι → ℝ) (c : ι → ℂ) (δ : ℝ)
    (hδ : 0 ≤ δ) (hlam : ∀ i, |lam i| ≤ δ) :
    ∑ i, ‖(lam i : ℂ) * c i‖ ^ 2 ≤ δ ^ 2 * ∑ i, ‖c i‖ ^ 2 := by
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro i _
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, mul_pow]
  exact mul_le_mul_of_nonneg_right
    (pow_le_pow_left₀ (abs_nonneg _) (hlam i) 2) (sq_nonneg _)

end MainRandomizer
