import MainHolevo

noncomputable section
set_option maxHeartbeats 1200000
set_option backward.isDefEq.respectTransparency false
open scoped BigOperators Kronecker Matrix

namespace MainHolevo
variable {n d ι : Type} [Fintype n] [Fintype d] [Fintype ι]
variable [DecidableEq n] [DecidableEq d] [DecidableEq ι]

/-- Isometry inserting a specified basis flag. -/
def flagInsertMat (i : ι) : Matrix (n × ι) n ℂ :=
  fun x y ↦ if x.2 = i ∧ x.1 = y then 1 else 0

theorem flagInsertMat_isometry (i : ι) :
    (flagInsertMat (n := n) i).conjTranspose * flagInsertMat (n := n) i = 1 := by
  ext a b
  by_cases hab : a = b
  · subst b
    simp [flagInsertMat, Matrix.mul_apply, Matrix.conjTranspose_apply,
      Fintype.sum_prod_type, Matrix.one_apply, ite_and]
  · simp [flagInsertMat, Matrix.mul_apply, Matrix.conjTranspose_apply,
      Fintype.sum_prod_type, Matrix.one_apply, ite_and, hab, Ne.symm hab]

/-- The actual channel that appends a fixed classical flag. -/
def flagInsert (i : ι) : CPTPMap n (n × ι) where
  toLinearMap := MatrixMap.conj (flagInsertMat (n := n) i)
  cp := MatrixMap.conj_isCompletelyPositive _
  TP := by
    intro X
    change Matrix.trace (flagInsertMat (n := n) i * X * (flagInsertMat (n := n) i).conjTranspose) = _
    rw [Matrix.trace_mul_cycle, flagInsertMat_isometry, Matrix.one_mul]

@[simp] theorem flagInsert_apply (i : ι) (ρ : MState n) :
    flagInsert (n := n) i ρ = ρ ⊗ᴹ MState.pure (Ket.basis i) := by
  apply MState.ext_m
  ext ⟨a,x⟩ ⟨b,y⟩
  change ((flagInsertMat (n := n) i) * ρ.m * (flagInsertMat (n := n) i).conjTranspose) (a,x) (b,y) =
    ρ.m a b * (MState.pure (Ket.basis i)).m x y
  by_cases hx : x = i <;> by_cases hy : y = i <;>
    simp [flagInsertMat, Matrix.mul_apply, Matrix.conjTranspose_apply,
      MState.pure_apply, Ket.basis, Ket.apply, ite_and, hx, hy, eq_comm]
  all_goals aesop

theorem flaggedExtension_comp_flagInsert (Φ : CPTPMap n d)
    (U : ι → Matrix.unitaryGroup d ℂ) (i : ι) :
    (flaggedExtension Φ U) ∘ₘ flagInsert i = (CPTPMap.ofUnitary (U i)) ∘ₘ Φ := by
  apply CPTPMap.funext
  intro ρ
  simp only [CPTPMap.compose_eq, flagInsert_apply, flaggedExtension_basis,
    CPTPMap.ofUnitary_eq_conj]

/-- Tensor products preserve composition of channels. -/
theorem channel_prod_comp {a b c a' b' c' : Type}
    [Fintype a] [Fintype b] [Fintype c] [Fintype a'] [Fintype b'] [Fintype c']
    [DecidableEq a] [DecidableEq b] [DecidableEq c]
    [DecidableEq a'] [DecidableEq b'] [DecidableEq c']
    (Φ₁ : CPTPMap a b) (Φ₂ : CPTPMap b c)
    (Ψ₁ : CPTPMap a' b') (Ψ₂ : CPTPMap b' c') :
    (Φ₂ ∘ₘ Φ₁) ⊗ᶜᵖ (Ψ₂ ∘ₘ Ψ₁) = (Φ₂ ⊗ᶜᵖ Ψ₂) ∘ₘ (Φ₁ ⊗ᶜᵖ Ψ₁) := by
  apply CPTPMap.ext
  exact MatrixMap.kron_comp_distrib _ _ _ _

theorem channel_unitary_prod (U : Matrix.unitaryGroup d ℂ)
    (V : Matrix.unitaryGroup d ℂ) :
    (CPTPMap.ofUnitary U) ⊗ᶜᵖ (CPTPMap.ofUnitary V) = CPTPMap.ofUnitary (U ⊗ᵤ V) := by
  apply CPTPMap.ext
  exact MatrixMap.conj_kron U.val V.val

/-- The two-copy completion contains the full independent unitary orbit of
every two-copy output, including outputs generated by entangled inputs. -/
theorem flaggedExtension_tensor_input (Φ : CPTPMap n d)
    (U : ι → Matrix.unitaryGroup d ℂ) (ρ : MState (n × n)) (i j : ι) :
    ((flaggedExtension Φ U) ⊗ᶜᵖ (flaggedExtension Φ U))
      (((flagInsert (n := n) i) ⊗ᶜᵖ (flagInsert (n := n) j)) ρ) =
        ((Φ ⊗ᶜᵖ Φ) ρ).uConj ((U i) ⊗ᵤ (U j)) := by
  change (((flaggedExtension Φ U) ⊗ᶜᵖ (flaggedExtension Φ U)) ∘ₘ
    ((flagInsert (n := n) i) ⊗ᶜᵖ (flagInsert (n := n) j))) ρ = _
  rw [← channel_prod_comp, flaggedExtension_comp_flagInsert,
    flaggedExtension_comp_flagInsert, channel_prod_comp, channel_unitary_prod]
  rfl

/-- A concrete two-copy orbit ensemble gives the required Holevo lower bound. -/
theorem flaggedExtension_tensor_holevo_lower [Nonempty ι] [Nonempty d]
    (Φ : CPTPMap n d) (U : ι → Matrix.unitaryGroup d ℂ)
    (ρ : MState (n × n))
    (htwirl : average ProbDistribution.uniform
      (fun ij : ι × ι ↦ ((Φ ⊗ᶜᵖ Φ) ρ).uConj ((U ij.1) ⊗ᵤ (U ij.2))) = MState.uniform) :
    2 * Real.log (Fintype.card d) - Sᵥₙ ((Φ ⊗ᶜᵖ Φ) ρ) ≤
      holevo ((flaggedExtension Φ U) ⊗ᶜᵖ (flaggedExtension Φ U)) := by
  have h := orbit_ensembleHolevo
    ((flaggedExtension Φ U) ⊗ᶜᵖ (flaggedExtension Φ U))
    (fun ij : ι × ι ↦ ((flagInsert (n := n) ij.1) ⊗ᶜᵖ (flagInsert (n := n) ij.2)) ρ)
    ((Φ ⊗ᶜᵖ Φ) ρ) (fun ij : ι × ι ↦ (U ij.1) ⊗ᵤ (U ij.2))
    (fun ij ↦ flaggedExtension_tensor_input Φ U ρ ij.1 ij.2) htwirl
  simpa [Fintype.card_prod, Nat.cast_mul, Real.log_mul, two_mul] using h

end MainHolevo
