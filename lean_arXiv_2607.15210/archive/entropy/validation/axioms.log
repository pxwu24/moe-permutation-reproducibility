AppendixB.single_output_infimum {t p : ℝ} (ht0 : 0 < t) (ht1 : t < 1) (hp : 0 < p) (r : ℕ) (hr : 1 ≤ r) :
  ∃ C,
    0 ≤ C ∧
      ∃ k₀,
        ∀ (k : ℕ),
          k₀ ≤ ↑k →
            |AppendixB.infimumOutputEntropy p t k r - (Real.log ↑(k.choose r) - 2 * p * (1 - t) / (t * ↑r * ↑k ^ 2))| ≤
              C / (↑k ^ 2 * √↑k)
AppendixB.single_output_r1_infimum {t p : ℝ} (ht0 : 0 < t) (ht1 : t < 1) (hp : 0 < p) :
  ∃ C,
    0 ≤ C ∧
      ∃ k₀,
        ∀ (k : ℕ),
          k₀ ≤ ↑k →
            |sInf {s | ∃ q ∈ AppendixB.Lam k t, s = AppendixB.renyi p Finset.univ (fun x => 1) q} -
                  (Real.log ↑k - 2 * p * (1 - t) / (t * ↑k ^ 2))| ≤
              C / (↑k ^ 2 * √↑k)
AppendixB.bell_output_r1 {t p : ℝ} (ht0 : 0 < t) (ht1 : t < 1) (hp : 0 < p) :
  ∃ C k₀,
    ∀ (k : ℕ),
      k₀ ≤ ↑k →
        |AppendixB.renyi p Finset.univ ![1, ↑k ^ 2 - 1] ![AppendixB.alphaB k t, AppendixB.betaB k t] -
              (2 * Real.log ↑k - AppendixB.Ap p t / ↑k ^ 2)| ≤
          C / ↑k ^ 4
AppendixB.bell_output {t p : ℝ} (ht0 : 0 < t) (ht1 : t < 1) (hp : 0 < p) (r : ℕ) (hr : 1 ≤ r) :
  ∃ C k₀,
    ∀ (k : ℕ),
      k₀ ≤ ↑k →
        |AppendixB.renyi p (Finset.range (r + 1)) (AppendixB.dm k) (AppendixB.bellNu k r t) -
              (2 * Real.log ↑(k.choose r) - AppendixB.Bpr p (↑r) ((1 - t) / t) / ↑k ^ 2)| ≤
          C / ↑k ^ 3
