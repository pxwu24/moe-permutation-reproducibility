'ProjectionChannels.bernoulli_free_sum_right_edge' depends on axioms: [propext, Classical.choice, Quot.sound]
'ProjectionChannels.fixed_random_compression_from_block_strong' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
'ProjectionChannels.random_compression_from_block_strong' depends on axioms: [propext, Classical.choice, Quot.sound]
'ProjectionChannels.random_compression_from_amplified_block_strong' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
'ProjectionChannels.norm_kronecker_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
def ProjectionChannels.BlockModifiedStrongInput.{u_2} : {Ω : Type u_2} →
  [inst : MeasurableSpace Ω] →
    MeasureTheory.Measure Ω →
      (k : ℕ) → ℝ → (Ω → (m : ℕ) → Matrix (Fin (m + 1) × Fin k) (Fin (m + 1) × Fin k) ℂ) → Prop :=
fun {Ω} [MeasurableSpace Ω] μ k t P =>
  ∀ (a : Fin k → ℝ),
    ∃ ν,
      ProjectionChannels.IsBernoulliFreeSumLaw k t a ν ∧
        ∀ (c : ℝ),
          ∀ᵐ (ω : Ω) ∂μ,
            Filter.Tendsto
              (fun m => ‖↑c • 1 + ProjectionChannels.blockCompression (ProjectionChannels.diagonalBlock (P ω m)) a‖)
              Filter.atTop (nhds (sSup ((fun x => |c + x|) '' ProjectionChannels.realMeasureSupport ν)))
ProjectionChannels.IsBernoulliFreeSumLaw (k : ℕ) (t : ℝ) (a : Fin k → ℝ) (μ : MeasureTheory.Measure ℝ) : Prop
ProjectionChannels.bernoulli_free_sum_right_edge {k : ℕ} (hk : 0 < k) {t : ℝ} (ht0 : 0 < t) (ht1 : t < 1)
  (a : Fin k → ℝ) (μ : MeasureTheory.Measure ℝ) (hμ : ProjectionChannels.IsBernoulliFreeSumLaw k t a μ) :
  sSup (ProjectionChannels.realMeasureSupport μ) = sSup (ProjectionChannels.bernoulliObjectiveValues t (↑k) a)
ProjectionChannels.random_compression_from_block_strong.{u_2} {Ω : Type u_2} [MeasurableSpace Ω]
  (μ : MeasureTheory.Measure Ω) (k : ℕ) (hk : 0 < k) (t : ℝ) (ht0 : 0 < t) (ht1 : t < 1)
  (P : Ω → (m : ℕ) → Matrix (Fin (m + 1) × Fin k) (Fin (m + 1) × Fin k) ℂ) (hH : ∀ (ω : Ω) (m : ℕ), (P ω m).IsHermitian)
  (hId : ∀ (ω : Ω) (m : ℕ), P ω m * P ω m = P ω m) (hBM : ProjectionChannels.BlockModifiedStrongInput μ k t P) :
  ∀ᵐ (ω : Ω) ∂μ,
    ∀ (a : Fin k → ℝ),
      Filter.Tendsto (fun m => ProjectionChannels.largestEigenvalue ⋯) Filter.atTop
        (nhds (ProjectionChannels.bernoulliSupport t (↑k) a))
