ProjectionChannels.canonical_fullBlockModifiedStrongInput_one {t : ℝ} (ht0 : 0 < t) (ht1 : t < 1) :
  ProjectionChannels.FullBlockModifiedStrongInput (ProjectionChannels.Canonical.probability 1) 1 t
    (ProjectionChannels.Canonical.projection 1 t) ⋯
ProjectionChannels.ScalarStrong.canonical_projection_scalar_strong {k : ℕ} (hk : 0 < k) {t : ℝ} (ht0 : 0 < t)
  (ht1 : t < 1) (ω : ProjectionChannels.Canonical.Sample k) (a : ℝ) :
  (∀ (c : ℝ),
      Filter.Tendsto (fun n => ‖↑c • 1 + ↑a • ProjectionChannels.Canonical.projection k t ω n‖) Filter.atTop
        (nhds
          (sSup
            ((fun x => |c + x|) ''
              ProjectionChannels.realMeasureSupport (ProjectionChannels.scalarBernoulliMeasure t a))))) ∧
    ∀ (f : ℝ → ℝ),
      Continuous f →
        Filter.Tendsto
          (fun n =>
            1 / (↑k * (↑n + 1)) *
              RevisionMatrixEntropy.spectralTrace f (a • ProjectionChannels.Canonical.projection k t ω n))
          Filter.atTop (nhds (∫ (x : ℝ), f x ∂ProjectionChannels.scalarBernoulliMeasure t a))
