HaarProjection.haar_projection_partialTrace_rank_fin {n k d : ℕ} (hd : d ≤ n * k)
  (P₀ : Matrix (Fin n × Fin k) (Fin n × Fin k) ℂ) (hP₀ : P₀.IsHermitian) (hp₀ : P₀ * P₀ = P₀) (hr₀ : P₀.rank = d) :
  ∀ᵐ (U : ↥(Matrix.unitaryGroup (Fin n × Fin k) ℂ)) ∂HaarProjection.unitaryHaar,
    (PreliminariesMatrix.traceB (↑U * P₀ * (↑U).conjTranspose)).rank = min n (k * d)
HaarProjection.haar_projection_full_local_support_iff_fin {n k d : ℕ} (hd : d ≤ n * k)
  (P₀ : Matrix (Fin n × Fin k) (Fin n × Fin k) ℂ) (hP₀ : P₀.IsHermitian) (hp₀ : P₀ * P₀ = P₀) (hr₀ : P₀.rank = d) :
  (∀ᵐ (U : ↥(Matrix.unitaryGroup (Fin n × Fin k) ℂ)) ∂HaarProjection.unitaryHaar,
      (PreliminariesMatrix.traceB (↑U * P₀ * (↑U).conjTranspose)).PosDef) ↔
    n ≤ k * d
ProjectionChannels.random_compression_from_amplified_block_strong.{u_2} {Ω : Type u_2} [MeasurableSpace Ω]
  (μ : MeasureTheory.Measure Ω) (k : ℕ) (hk : 0 < k) (t : ℝ) (ht0 : 0 < t) (ht1 : t < 1)
  (P : Ω → (m : ℕ) → Matrix (Fin (m + 1) × Fin k) (Fin (m + 1) × Fin k) ℂ) (hH : ∀ (ω : Ω) (m : ℕ), (P ω m).IsHermitian)
  (hId : ∀ (ω : Ω) (m : ℕ), P ω m * P ω m = P ω m)
  (hBM : ProjectionChannels.AmplifiedBlockModifiedStrongInput μ k t P) :
  ∀ᵐ (ω : Ω) ∂μ,
    ∀ (a : Fin k → ℝ),
      Filter.Tendsto (fun m => ProjectionChannels.largestEigenvalue ⋯) Filter.atTop
        (nhds (ProjectionChannels.bernoulliSupport t (↑k) a))
ProjectionChannels.fixed_random_compression_from_block_strong.{u_2} {Ω : Type u_2} [MeasurableSpace Ω]
  (μ : MeasureTheory.Measure Ω) (k : ℕ) (hk : 0 < k) (t : ℝ) (ht0 : 0 < t) (ht1 : t < 1)
  (P : Ω → (m : ℕ) → Matrix (Fin (m + 1) × Fin k) (Fin (m + 1) × Fin k) ℂ) (hH : ∀ (ω : Ω) (m : ℕ), (P ω m).IsHermitian)
  (hId : ∀ (ω : Ω) (m : ℕ), P ω m * P ω m = P ω m) (hBM : ProjectionChannels.BlockModifiedStrongInput μ k t P)
  (a : Fin k → ℝ) :
  ∀ᵐ (ω : Ω) ∂μ,
    Filter.Tendsto (fun m => ProjectionChannels.largestEigenvalue ⋯) Filter.atTop
      (nhds (ProjectionChannels.bernoulliSupport t (↑k) a))
ProjectionStrongConvergence.projections_strongly_converge_to_bernoulli {κ : ℕ → Type} [(n : ℕ) → Fintype (κ n)]
  [(n : ℕ) → DecidableEq (κ n)] [∀ (n : ℕ), Nonempty (κ n)] (P : (n : ℕ) → Matrix (κ n) (κ n) ℂ)
  (hH : ∀ (n : ℕ), (P n).IsHermitian) (hP : ∀ (n : ℕ), P n * P n = P n) (t : ℝ) (ht0 : 0 < t) (ht1 : t < 1)
  (hr : Filter.Tendsto (fun n => ↑(P n).rank / ↑(Fintype.card (κ n))) Filter.atTop (nhds t)) (q : Polynomial ℂ) :
  Filter.Tendsto (fun n => ProjectionStrongConvergence.normalizedTrace ((Polynomial.aeval (P n)) q)) Filter.atTop
      (nhds ((1 - ↑t) * Polynomial.eval 0 q + ↑t * Polynomial.eval 1 q)) ∧
    Filter.Tendsto (fun n => ‖(Polynomial.aeval (P n)) q‖) Filter.atTop
      (nhds (max ‖Polynomial.eval 0 q‖ ‖Polynomial.eval 1 q‖))
ProjectionChannels.amplified_diagonalTrace {n k : Type} [Fintype n] [Fintype k] [DecidableEq n] [DecidableEq k]
  (a : k → ℝ) (P : Matrix (n × k) (n × k) ℂ) :
  ProjectionChannelsCP.amplify (ProjectionChannels.diagonalTraceLinearMap a) P =
    (ProjectionChannels.blockCompression (ProjectionChannels.diagonalBlock P) a).kronecker 1
ProjectionChannels.FullBlockModifiedStrongInput.to_amplified.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  {μ : MeasureTheory.Measure Ω} {k : ℕ} {t : ℝ} {P : Ω → (m : ℕ) → Matrix (Fin (m + 1) × Fin k) (Fin (m + 1) × Fin k) ℂ}
  {hP : ∀ (ω : Ω) (m : ℕ), (P ω m).IsHermitian} (h : ProjectionChannels.FullBlockModifiedStrongInput μ k t P hP)
  (U : ↥(Matrix.unitaryGroup (Fin k) ℂ)) :
  ProjectionChannels.AmplifiedBlockModifiedStrongInput μ k t fun ω m => RevisionOutput.localConjugate (P ω m) ↑U
ProjectionChannels.bernoulli_free_sum_right_edge {k : ℕ} (hk : 0 < k) {t : ℝ} (ht0 : 0 < t) (ht1 : t < 1)
  (a : Fin k → ℝ) (μ : MeasureTheory.Measure ℝ) (hμ : ProjectionChannels.IsBernoulliFreeSumLaw k t a μ) :
  sSup (ProjectionChannels.realMeasureSupport μ) = sSup (ProjectionChannels.bernoulliObjectiveValues t (↑k) a)
ProjectionChannels.bernoulli_edge_from_cauchy_characterization.{u_1} {ι : Type u_1} [Fintype ι]
  (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ] (r : ℝ)
  (hr : r ∈ ProjectionChannels.realMeasureSupport μ) (hbound : ∀ᵐ (s : ℝ) ∂μ, s ≤ r) (t k : ℝ) (a : ι → ℝ) (ht0 : 0 < t)
  (ht1 : t < 1) (hk : 0 < k)
  (hgerm :
    ∀ᶠ (x : ℝ) in Filter.atTop, ProjectionChannels.bernoulliK t k a (ProjectionChannels.realCauchyTransform μ x) = x) :
  IsGLB (ProjectionChannels.bernoulliKValues t k a) r ∧ r = sSup (ProjectionChannels.bernoulliObjectiveValues t k a)
RevisionOutput.output_space_limit.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω) {k : ℕ}
  [NeZero k] {t : ℝ} (hk : 0 < k) (ht : 0 < t) (ht1 : t < 1) (hkt : 1 < ↑k ^ 2 * t)
  (P : Ω → (N : ℕ) → Matrix (Fin (N + 1) × Fin k) (Fin (N + 1) × Fin k) ℂ) (hH : ∀ (ω : Ω) (N : ℕ), (P ω N).IsHermitian)
  (hId : ∀ (ω : Ω) (N : ℕ), P ω N * P ω N = P ω N)
  (hStrong : ProjectionChannels.FullBlockModifiedStrongInput μ k t P hH) :
  ∀ᵐ (ω : Ω) ∂μ,
    Filter.Tendsto
      (fun N =>
        RevisionOutput.traceHausdorff
          (RevisionOutput.normalizedOutput (P ω N) (RevisionOutput.marginalNormalizer (P ω N) ⋯) ''
            RevisionOutput.densityMatrices (Fin (N + 1)))
          (RevisionOutput.spectralBody k t))
      Filter.atTop (nhds 0)
RevisionOutput.trace_distance_density_formula {k : ℕ} [NeZero k] {X Y : Matrix (Fin k) (Fin k) ℂ}
  (hX : X ∈ RevisionOutput.densityMatrices (Fin k)) (hY : Y ∈ RevisionOutput.densityMatrices (Fin k)) :
  RevisionOutput.hermitianTraceNorm (X - Y) = ∑ i, |⋯.eigenvalues i|
RevisionOutput.raw_normalizedOutput_posSemidef {A B : Type} [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
  [Nonempty A] [Nonempty B] (P : Matrix (A × B) (A × B) ℂ) (hP : P.PosSemidef) {ρ : Matrix A A ℂ}
  (hρ : ρ ∈ RevisionOutput.densityMatrices A) :
  (RevisionOutput.normalizedOutput P (RevisionOutput.marginalNormalizer P hP) ρ).PosSemidef
RevisionMatrixEntropy.actual_minimum_output_entropy_limit.{u_1} {Ω : Type u_1} [MeasurableSpace Ω]
  (μ : MeasureTheory.Measure Ω) {k : ℕ} [NeZero k] {t : ℝ} (hk : 0 < k) (ht : 0 < t) (ht1 : t < 1)
  (hkt : 1 < ↑k ^ 2 * t) (P : Ω → (N : ℕ) → Matrix (Fin (N + 1) × Fin k) (Fin (N + 1) × Fin k) ℂ)
  (hH : ∀ (ω : Ω) (N : ℕ), (P ω N).IsHermitian) (hId : ∀ (ω : Ω) (N : ℕ), P ω N * P ω N = P ω N)
  (hStrong : ProjectionChannels.FullBlockModifiedStrongInput μ k t P hH) (p : ℝ) (hp : 0 < p) :
  ∀ᵐ (ω : Ω) ∂μ,
    Filter.Tendsto
      (fun N =>
        sInf
          (RevisionMatrixEntropy.matrixRenyiEntropy p ''
            (RevisionOutput.normalizedOutput (P ω N) (RevisionOutput.marginalNormalizer (P ω N) ⋯) ''
              RevisionOutput.densityMatrices (Fin (N + 1)))))
      Filter.atTop (nhds (sInf ((AppendixB.renyi p Finset.univ fun x => 1) '' AppendixB.Lam k t)))
RevisionMatrixEntropy.spectralBody_entropy_image (k : ℕ) (t p : ℝ) (hp : 0 < p) :
  RevisionMatrixEntropy.matrixRenyiEntropy p '' RevisionOutput.spectralBody k t =
    (AppendixB.renyi p Finset.univ fun x => 1) '' AppendixB.Lam k t
AppendixB.single_output_r1_minimum {t p : ℝ} (ht0 : 0 < t) (ht1 : t < 1) (hp : 0 < p) :
  ∃ C,
    0 ≤ C ∧
      ∃ k₀,
        ∀ (k : ℕ),
          k₀ ≤ ↑k →
            ∃ q ∈ AppendixB.Lam k t,
              (∀ q' ∈ AppendixB.Lam k t,
                  AppendixB.renyi p Finset.univ (fun x => 1) q ≤ AppendixB.renyi p Finset.univ (fun x => 1) q') ∧
                |AppendixB.renyi p Finset.univ (fun x => 1) q - (Real.log ↑k - 2 * p * (1 - t) / (t * ↑k ^ 2))| ≤
                  C / (↑k ^ 2 * √↑k)
RevisionOutput.traceHausdorff_eq_matrixSupportDistance {k : ℕ} [NeZero k] (C K : Set (Matrix (Fin k) (Fin k) ℂ))
  (hC : IsCompact C) (hK : IsCompact K) (hneC : C.Nonempty) (hneK : K.Nonempty) (hcC : Convex ℝ C) (hcK : Convex ℝ K)
  (hHC : ∀ M ∈ C, M.IsHermitian) (hHK : ∀ M ∈ K, M.IsHermitian) :
  RevisionOutput.traceHausdorff C K =
    sSup
      ((fun H => |RevisionOutput.matrixSupport C H - RevisionOutput.matrixSupport K H|) ''
        {H | H.IsHermitian ∧ RevisionOutput.hermitianOperatorNorm H ≤ 1})
RevisionOutput.trace_operator_duality_named {k : ℕ} [NeZero k] (M : Matrix (Fin k) (Fin k) ℂ) (hM : M.IsHermitian) :
  IsGreatest ((fun H => (H * M).trace.re) '' {H | H.IsHermitian ∧ RevisionOutput.hermitianOperatorNorm H ≤ 1})
    (∑ i, |hM.eigenvalues i|)
RevisionOutput.density_opNorm_witness {k : ℕ} [NeZero k] (H : Matrix (Fin k) (Fin k) ℂ) (hH : H.IsHermitian) :
  ∃ ρ ∈ RevisionOutput.densityMatrices (Fin k), |(H * ρ).trace.re| = RevisionOutput.hermitianOperatorNorm H
RevisionOutput.normalized_output_support.{u_1, u_2} {A : Type u_1} {B : Type u_2} [Fintype A] [DecidableEq A]
  [Nonempty A] [Fintype B] [DecidableEq B] (P : Matrix (A × B) (A × B) ℂ) (hP : P.IsHermitian) (D : Matrix A A ℂ)
  (hD : D.IsHermitian) (H : Matrix B B ℂ) (hH : H.IsHermitian) :
  RevisionOutput.outputSupport P D H = ProjectionChannels.largestEigenvalue ⋯
RevisionOutput.local_channel_support_threshold.{u_1, u_2} {A : Type u_1} {B : Type u_2} [Fintype A] [DecidableEq A]
  [Nonempty A] [Fintype B] [DecidableEq B] (P : Matrix (A × B) (A × B) ℂ) (hP : P.IsHermitian)
  (hA : (PreliminariesMatrix.traceB P).PosDef) (H : Matrix B B ℂ) (hH : H.IsHermitian) :
  RevisionOutput.outputSupport P (⋯ : (PreliminariesMatrix.traceB P).PosSemidef).sqrt⁻¹ H =
    sInf {z | ProjectionChannels.largestEigenvalue ⋯ ≤ 0}
RevisionOutput.density_expectation_isGreatest.{u_1} {A : Type u_1} [Fintype A] [DecidableEq A] [Nonempty A]
  (M : Matrix A A ℂ) (hM : M.IsHermitian) :
  IsGreatest ((fun ρ => (M * ρ).trace.re) '' RevisionOutput.densityMatrices A) (ProjectionChannels.largestEigenvalue hM)
RevisionOutput.normalizedOutput_pairing.{u_1, u_2} {A : Type u_1} {B : Type u_2} [Fintype A] [DecidableEq A]
  [Nonempty A] [Fintype B] [DecidableEq B] (P : Matrix (A × B) (A × B) ℂ) (D ρ : Matrix A A ℂ) (H : Matrix B B ℂ) :
  (H * RevisionOutput.normalizedOutput P D ρ).trace = (D * RevisionOutput.contraction P H * D * ρ.transpose).trace
RevisionBell.bell_output_limit.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω) {k : ℕ} [NeZero k]
  {t : ℝ} (hk : 0 < k) (ht0 : 0 < t) (ht1 : t < 1) (hkt : 1 < ↑k ^ 2 * t)
  (P : Ω → (n : ℕ) → Matrix (Fin (n + 1) × Fin k) (Fin (n + 1) × Fin k) ℂ) (hH : ∀ (ω : Ω) (n : ℕ), (P ω n).IsHermitian)
  (hId : ∀ (ω : Ω) (n : ℕ), P ω n * P ω n = P ω n)
  (hFull : ProjectionChannels.FullBlockModifiedStrongInput μ k t P hH) :
  let D := fun ω n => RevisionOutput.marginalNormalizer (P ω n) ⋯;
  ∀ᵐ (ω : Ω) ∂μ,
    Filter.Tendsto
      (fun n =>
        ‖RevisionBell.tensorMap (RevisionOutput.normalizedOutput (P ω n) (D ω n))
              (ProjectionChannels.conjugateMap (RevisionOutput.normalizedOutput (P ω n) (D ω n)))
              (RevisionBell.bellState (Fin (n + 1))) -
            RevisionBell.isotropic (Fin k) (BellLimitVerification.mixing (↑k) t)‖)
      Filter.atTop (nhds 0)
RevisionBell.bell_output_and_purity_limit.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω) {k : ℕ}
  [NeZero k] {t : ℝ} (hk : 0 < k) (ht0 : 0 < t) (ht1 : t < 1) (hkt : 1 < ↑k ^ 2 * t)
  (P : Ω → (n : ℕ) → Matrix (Fin (n + 1) × Fin k) (Fin (n + 1) × Fin k) ℂ) (hH : ∀ (ω : Ω) (n : ℕ), (P ω n).IsHermitian)
  (hId : ∀ (ω : Ω) (n : ℕ), P ω n * P ω n = P ω n)
  (hFull : ProjectionChannels.FullBlockModifiedStrongInput μ k t P hH) :
  let D := fun ω n => RevisionOutput.marginalNormalizer (P ω n) ⋯;
  ∀ᵐ (ω : Ω) ∂μ,
    Filter.Tendsto
        (fun n =>
          ‖RevisionBell.tensorMap (RevisionOutput.normalizedOutput (P ω n) (D ω n))
                (ProjectionChannels.conjugateMap (RevisionOutput.normalizedOutput (P ω n) (D ω n)))
                (RevisionBell.bellState (Fin (n + 1))) -
              RevisionBell.isotropic (Fin k) (BellLimitVerification.mixing (↑k) t)‖)
        Filter.atTop (nhds 0) ∧
      Filter.Tendsto
        (fun n =>
          (RevisionBell.normalizedChoi (P ω n) (D ω n) * RevisionBell.normalizedChoi (P ω n) (D ω n)).trace /
            (↑(n + 1) * ↑k))
        Filter.atTop (nhds ↑(BellLimitVerification.bellAlpha (↑k) t))
RevisionBell.tensor_conjugate_bell_entry.{u_1, u_2} {A : Type u_1} {B : Type u_2} [Fintype A] [Fintype B]
  [DecidableEq A] [DecidableEq B] (Φ : Matrix A A ℂ → Matrix B B ℂ) (i p j q : B) :
  RevisionBell.tensorMap Φ (ProjectionChannels.conjugateMap Φ) (RevisionBell.bellState A) (i, p) (j, q) =
    BellLimitVerification.bellEntry (ProjectionChannels.choiInput Φ) i p j q
BellLimitVerification.bell_spectrum_identities {k t : ℝ} (hk : k ≠ 0)
  (hden : BellLimitVerification.denominator k t ≠ 0) :
  BellLimitVerification.bellBeta k t = (1 - BellLimitVerification.mixing k t) / k ^ 2 ∧
    BellLimitVerification.bellAlpha k t = BellLimitVerification.bellBeta k t + BellLimitVerification.mixing k t ∧
      BellLimitVerification.bellAlpha k t + (k ^ 2 - 1) * BellLimitVerification.bellBeta k t = 1
BellLimitVerification.bell_spectrum_positive {k t : ℝ} (hk : 1 < k) (ht : 0 < t) (ht1 : t < 1) (hkt : 1 < k ^ 2 * t) :
  0 < BellLimitVerification.bellBeta k t ∧ BellLimitVerification.bellBeta k t < BellLimitVerification.bellAlpha k t
RevisionMatrixEntropy.corollary_IV_2_fixed_k.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
  {k : ℕ} [NeZero k] {t : ℝ} (hk : 0 < k) (ht : 0 < t) (ht1 : t < 1) (hkt : 1 < ↑k ^ 2 * t)
  (P : Ω → (N : ℕ) → Matrix (Fin (N + 1) × Fin k) (Fin (N + 1) × Fin k) ℂ) (hH : ∀ (ω : Ω) (N : ℕ), (P ω N).IsHermitian)
  (hId : ∀ (ω : Ω) (N : ℕ), P ω N * P ω N = P ω N)
  (hStrong : ProjectionChannels.FullBlockModifiedStrongInput μ k t P hH) (p : ℝ) (hp : 0 < p) :
  let Φ := fun ω N => RevisionOutput.normalizedOutput (P ω N) (RevisionOutput.marginalNormalizer (P ω N) ⋯);
  ∀ᵐ (ω : Ω) ∂μ,
    Filter.limsup
        (fun N =>
          RevisionMatrixEntropy.minimumOutputEntropy p
            (RevisionBell.tensorMap (Φ ω N) (ProjectionChannels.conjugateMap (Φ ω N))))
        Filter.atTop ≤
      AppendixB.renyi p Finset.univ ![1, ↑k ^ 2 - 1] ![AppendixB.alphaB k t, AppendixB.betaB k t]
RevisionMatrixEntropy.isotropic_entropy_eq_bell_spectrum {k : ℕ} [NeZero k] (t p : ℝ) (hp : 0 < p) :
  RevisionMatrixEntropy.matrixRenyiEntropy p (RevisionBell.isotropic (Fin k) (BellLimitVerification.mixing (↑k) t)) =
    AppendixB.renyi p Finset.univ ![1, ↑k ^ 2 - 1] ![AppendixB.alphaB k t, AppendixB.betaB k t]
RevisionMatrixEntropy.corollary_IV_2_asymptotics {t p : ℝ} (ht : 0 < t) (ht1 : t < 1) (hp : 0 < p) :
  ∃ C k₀,
    ∀ (k : ℕ),
      k₀ ≤ ↑k →
        |RevisionMatrixEntropy.matrixRenyiEntropy p
                (RevisionBell.isotropic (Fin k) (BellLimitVerification.mixing (↑k) t)) -
              (2 * Real.log ↑k - AppendixB.Ap p t / ↑k ^ 2)| ≤
          C / ↑k ^ 4
RevisionBell.bernoulli_logPotential_hessian {k : ℕ} (hk : 0 < k) {t : ℝ} (ht0 : 0 < t) (ht1 : t < 1)
  (hkt : 1 < ↑k ^ 2 * t) (h : Fin k → ℝ) (μ : ℝ → MeasureTheory.Measure ℝ)
  (hμ : ∀ᶠ (ε : ℝ) in nhds 0, ProjectionChannels.IsBernoulliFreeSumLaw k t (fun i => 1 + ε * h i) (μ ε)) :
  HasDerivAt (deriv fun ε => RevisionBell.logPotential (μ ε) 0)
    (BellLimitVerification.hessianC0 (↑k) t * (∑ i, h i) ^ 2 + BellLimitVerification.hessianC1 (↑k) t * ∑ i, h i ^ 2) 0
RevisionBell.bernoulli_law_logPotential_identity {k : ℕ} (hk : 0 < k) {t : ℝ} (ht0 : 0 < t) (ht1 : t < 1)
  (a : Fin k → ℝ) (μ : MeasureTheory.Measure ℝ) (hμ : ProjectionChannels.IsBernoulliFreeSumLaw k t a μ) (m M : ℝ)
  (hm : 0 < m) (hbound : ∀ᵐ (s : ℝ) ∂μ, m ≤ s ∧ s ≤ M) :
  RevisionBell.logPotential μ 0 =
    -Real.log (-ProjectionChannels.realCauchyTransform μ 0) - 1 -
      ↑k * ∑ i, RevisionBell.bernoulliPrimitive t (a i * ProjectionChannels.realCauchyTransform μ 0 / ↑k)
RevisionBell.normalized_choi_mixed_moment_limit.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
  {k : ℕ} [NeZero k] {t : ℝ} (hk : 0 < k) (ht0 : 0 < t) (ht1 : t < 1) (hkt : 1 < ↑k ^ 2 * t)
  (P : Ω → (n : ℕ) → Matrix (Fin (n + 1) × Fin k) (Fin (n + 1) × Fin k) ℂ) (hH : ∀ (ω : Ω) (n : ℕ), (P ω n).IsHermitian)
  (hId : ∀ (ω : Ω) (n : ℕ), P ω n * P ω n = P ω n)
  (hFull : ProjectionChannels.FullBlockModifiedStrongInput μ k t P hH) :
  let D := fun ω n => RevisionOutput.marginalNormalizer (P ω n) ⋯;
  ∀ᵐ (ω : Ω) ∂μ,
    ∀ (i j p q : Fin k),
      Filter.Tendsto
        (fun n =>
          1 / ↑(n + 1) *
            (BellLimitVerification.choiBlock (RevisionBell.normalizedChoi (P ω n) (D ω n)) i j *
                BellLimitVerification.choiBlock (RevisionBell.normalizedChoi (P ω n) (D ω n)) q p).trace)
        Filter.atTop
        (nhds
          ((-↑(BellLimitVerification.hessianC0 (↑k) t) * if i = j ∧ p = q then 1 else 0) -
            ↑(BellLimitVerification.hessianC1 (↑k) t) * if i = p ∧ j = q then 1 else 0))
RevisionBell.ae_normalized_choi_mixed_moments.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
  {k : ℕ} [NeZero k] {t : ℝ} (hk : 0 < k) (ht0 : 0 < t) (ht1 : t < 1) (hkt : 1 < ↑k ^ 2 * t)
  (P : Ω → (n : ℕ) → Matrix (Fin (n + 1) × Fin k) (Fin (n + 1) × Fin k) ℂ) (hH : ∀ (ω : Ω) (n : ℕ), (P ω n).IsHermitian)
  (hId : ∀ (ω : Ω) (n : ℕ), P ω n * P ω n = P ω n) (hFull : ProjectionChannels.FullBlockModifiedStrongInput μ k t P hH)
  (D : Ω → (n : ℕ) → Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) (hD : ∀ (ω : Ω) (n : ℕ), (D ω n).IsHermitian)
  (hn : ∀ᵐ (ω : Ω) ∂μ, ∀ᶠ (n : ℕ) in Filter.atTop, D ω n * PreliminariesMatrix.traceB (P ω n) * D ω n = 1) :
  ∀ᵐ (ω : Ω) ∂μ,
    ∀ (i j p q : Fin k),
      Filter.Tendsto
        (fun n =>
          1 / ↑(n + 1) *
            (BellLimitVerification.choiBlock (RevisionBell.normalizedChoi (P ω n) (D ω n)) i j *
                BellLimitVerification.choiBlock (RevisionBell.normalizedChoi (P ω n) (D ω n)) q p).trace)
        Filter.atTop
        (nhds
          ((-↑(BellLimitVerification.hessianC0 (↑k) t) * if i = j ∧ p = q then 1 else 0) -
            ↑(BellLimitVerification.hessianC1 (↑k) t) * if i = p ∧ j = q then 1 else 0))
RevisionBell.ae_normalized_square_moment_limit.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
  {k : ℕ} [NeZero k] {t : ℝ} (hk : 0 < k) (ht0 : 0 < t) (ht1 : t < 1) (hkt : 1 < ↑k ^ 2 * t)
  (P : Ω → (n : ℕ) → Matrix (Fin (n + 1) × Fin k) (Fin (n + 1) × Fin k) ℂ) (hH : ∀ (ω : Ω) (n : ℕ), (P ω n).IsHermitian)
  (hId : ∀ (ω : Ω) (n : ℕ), P ω n * P ω n = P ω n) (hFull : ProjectionChannels.FullBlockModifiedStrongInput μ k t P hH)
  (D : Ω → (n : ℕ) → Matrix (Fin (n + 1)) (Fin (n + 1)) ℂ) (hD : ∀ (ω : Ω) (n : ℕ), (D ω n).IsHermitian)
  (hn : ∀ᵐ (ω : Ω) ∂μ, ∀ᶠ (n : ℕ) in Filter.atTop, D ω n * PreliminariesMatrix.traceB (P ω n) * D ω n = 1)
  (H : Matrix (Fin k) (Fin k) ℂ) (hHerm : H.IsHermitian) :
  ∀ᵐ (ω : Ω) ∂μ,
    Filter.Tendsto
      (fun n =>
        1 / ↑(n + 1) *
          (D ω n * RevisionOutput.contraction (P ω n) H * D ω n *
                (D ω n * RevisionOutput.contraction (P ω n) H * D ω n)).trace.re)
      Filter.atTop
      (nhds
        (-BellLimitVerification.hessianC0 (↑k) t * H.trace.re * H.trace.re -
          BellLimitVerification.hessianC1 (↑k) t * (H * H).trace.re))
RevisionBell.asymptotic_choi_purity.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω) {k : ℕ}
  [NeZero k] {t : ℝ} (hk : 0 < k) (ht0 : 0 < t) (ht1 : t < 1) (hkt : 1 < ↑k ^ 2 * t)
  (P : Ω → (n : ℕ) → Matrix (Fin (n + 1) × Fin k) (Fin (n + 1) × Fin k) ℂ) (hH : ∀ (ω : Ω) (n : ℕ), (P ω n).IsHermitian)
  (hId : ∀ (ω : Ω) (n : ℕ), P ω n * P ω n = P ω n)
  (hFull : ProjectionChannels.FullBlockModifiedStrongInput μ k t P hH) :
  let D := fun ω n => RevisionOutput.marginalNormalizer (P ω n) ⋯;
  ∀ᵐ (ω : Ω) ∂μ,
    Filter.Tendsto
      (fun n =>
        (RevisionBell.normalizedChoi (P ω n) (D ω n) * RevisionBell.normalizedChoi (P ω n) (D ω n)).trace /
          (↑(n + 1) * ↑k))
      Filter.atTop (nhds ↑(BellLimitVerification.bellAlpha (↑k) t))
RevisionMain.theorem_V_1_fixed_k.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω) {k : ℕ}
  [NeZero k] {t : ℝ} (hk : 0 < k) (ht0 : 0 < t) (ht1 : t < 1) (hkt : 1 < ↑k ^ 2 * t) (r : ℕ) (hrk : r + 1 ≤ k)
  (P : Ω → (n : ℕ) → Matrix (Fin (n + 1) × Fin k) (Fin (n + 1) × Fin k) ℂ) (hH : ∀ (ω : Ω) (n : ℕ), (P ω n).IsHermitian)
  (hId : ∀ (ω : Ω) (n : ℕ), P ω n * P ω n = P ω n) (hFull : ProjectionChannels.FullBlockModifiedStrongInput μ k t P hH)
  (p : ℝ) (hp : 0 < p) :
  let Θ := fun ω n => RevisionMain.antisymmetricNormalizedChannel r (P ω n) ⋯;
  ∀ᵐ (ω : Ω) ∂μ,
    Filter.Tendsto (fun n => RevisionMatrixEntropy.minimumOutputEntropy p ⇑(Θ ω n)) Filter.atTop
        (nhds (AppendixB.infimumOutputEntropy p t k (r + 1))) ∧
      Filter.Tendsto
        (fun n =>
          RevisionMatrixEntropy.matrixRenyiEntropy p
            (RevisionBell.tensorMap (⇑(Θ ω n)) (ProjectionChannels.conjugateMap ⇑(Θ ω n))
              (RevisionBell.bellState (Fin (n + 1)))))
        Filter.atTop (nhds (RevisionMatrixEntropy.matrixRenyiEntropy p (RevisionMain.antisymmetricBellLimit k r t)))
RevisionMain.theorem_V_1_single_asymptotics {t p : ℝ} (ht0 : 0 < t) (ht1 : t < 1) (hp : 0 < p) (r : ℕ) :
  ∃ C,
    0 ≤ C ∧
      ∃ k₀,
        ∀ (k : ℕ),
          k₀ ≤ ↑k →
            r + 1 ≤ k ∧
              |sInf
                      ((fun M =>
                          RevisionMatrixEntropy.matrixRenyiEntropy p
                            (AntisymmetricVerification.antisymmetricChannel M)) ''
                        RevisionOutput.spectralBody k t) -
                    (Real.log ↑(k.choose (r + 1)) - 2 * p * (1 - t) / (t * (↑r + 1) * ↑k ^ 2))| ≤
                C / (↑k ^ 2 * √↑k)
RevisionMain.theorem_V_1_bell_asymptotics {t p : ℝ} (ht0 : 0 < t) (ht1 : t < 1) (hp : 0 < p) (r : ℕ) :
  ∃ C k₀,
    ∀ (k : ℕ),
      k₀ ≤ ↑k →
        |RevisionMatrixEntropy.matrixRenyiEntropy p (RevisionMain.antisymmetricBellLimit k r t) -
              (2 * Real.log ↑(k.choose (r + 1)) - AppendixB.Bpr p (↑r + 1) ((1 - t) / t) / ↑k ^ 2)| ≤
          C / ↑k ^ 3
RevisionMain.antisymmetricBellLimit_entropy {k r : ℕ} (hkr : 2 * (r + 1) ≤ k) (p : ℝ) (hp : 0 < p) (t : ℝ) :
  RevisionMatrixEntropy.matrixRenyiEntropy p (RevisionMain.antisymmetricBellLimit k r t) =
    AppendixB.renyi p (Finset.range (r + 2)) (AppendixB.dm k) (AppendixB.bellNu k (r + 1) t)
AntisymmetricVerification.postprocess_matrix_diagonal {k r : ℕ} (hr : 1 ≤ r) (hrk : r ≤ k)
  {X : Matrix (Fin k) (Fin k) ℂ} (hX : X.IsHermitian) (i : Fin r) :
  (LinearMap.toMatrix (AntisymmetricVerification.eigenSlaterBasis hX) (AntisymmetricVerification.eigenSlaterBasis hX))
      (AntisymmetricVerification.postprocessRestriction X i) =
    Matrix.diagonal fun I => ↑(AppendixB.shuffle k r hX.eigenvalues ↑I)
AntisymmetricVerification.shuffling_eigenbasis {k r : ℕ} (hr : 1 ≤ r) (hrk : r ≤ k) {X : Matrix (Fin k) (Fin k) ℂ}
  (hX : X.IsHermitian) (i : Fin r) :
  ∃ b,
    ∀ (I : AntisymmetricVerification.SubsetIndex k r),
      AntisymmetricVerification.postprocess X i ↑(b I) = ↑(AppendixB.shuffle k r hX.eigenvalues ↑I) • ↑(b I)
AntisymmetricVerification.finrank_alternatingSpace {k r : ℕ} :
  Module.finrank ℂ ↥(AntisymmetricVerification.alternatingSpace k r) = k.choose r
AntisymmetricVerification.antisymmetricChannel_quantumChannel {k r : ℕ} (hrk : r + 1 ≤ k) :
  ProjectionChannelsCP.CompletelyPositive AntisymmetricVerification.antisymmetricChannel ∧
    ProjectionChannelsCP.TracePreserving AntisymmetricVerification.antisymmetricChannel
AntisymmetricVerification.antisymmetricChannel_restriction_conjugate {k r : ℕ} (X : Matrix (Fin k) (Fin k) ℂ) :
  AntisymmetricVerification.slaterCoordinateEquiv.symm.conj (AntisymmetricVerification.postprocessRestriction X 0) =
    Matrix.toLin' (AntisymmetricVerification.antisymmetricChannel X)
AntisymmetricVerification.antisymmetric_spectralBody_entropy_image {k r : ℕ} (hrk : r + 1 ≤ k) (t p : ℝ) (hp : 0 < p) :
  (fun M => RevisionMatrixEntropy.matrixRenyiEntropy p (AntisymmetricVerification.antisymmetricChannel M)) ''
      RevisionOutput.spectralBody k t =
    (fun v => AppendixB.renyi p (AppendixB.subsets k (r + 1)) (fun x => 1) (AppendixB.shuffle k (r + 1) v)) ''
      AppendixB.Lam k t
AntisymmetricVerification.antisymmetric_body_infimum {k r : ℕ} (hrk : r + 1 ≤ k) (t p : ℝ) (hp : 0 < p) :
  sInf
      ((fun M => RevisionMatrixEntropy.matrixRenyiEntropy p (AntisymmetricVerification.antisymmetricChannel M)) ''
        RevisionOutput.spectralBody k t) =
    AppendixB.infimumOutputEntropy p t k (r + 1)
AppendixB.shuffled_entropy_attains_minimum {k r : ℕ} {t : ℝ} (hk : 0 < k) (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
  (hkt : 1 < ↑k ^ 2 * t) (hr : 1 ≤ r) (hrk : r ≤ k) (p : ℝ) (hpos : ∀ q ∈ AppendixB.Lam k t, ∀ (i : Fin k), 0 < q i) :
  ∃ q ∈ AppendixB.Lam k t,
    ∀ q' ∈ AppendixB.Lam k t,
      AppendixB.renyi p (AppendixB.subsets k r) (fun x => 1) (AppendixB.shuffle k r q) ≤
        AppendixB.renyi p (AppendixB.subsets k r) (fun x => 1) (AppendixB.shuffle k r q')
AppendixB.single_output_minimum {t p : ℝ} (ht0 : 0 < t) (ht1 : t < 1) (hp : 0 < p) (r : ℕ) (hr : 1 ≤ r) :
  ∃ C,
    0 ≤ C ∧
      ∃ k₀,
        ∀ (k : ℕ),
          k₀ ≤ ↑k →
            ∃ q ∈ AppendixB.Lam k t,
              (∀ q' ∈ AppendixB.Lam k t,
                  AppendixB.renyi p (AppendixB.subsets k r) (fun x => 1) (AppendixB.shuffle k r q) ≤
                    AppendixB.renyi p (AppendixB.subsets k r) (fun x => 1) (AppendixB.shuffle k r q')) ∧
                |AppendixB.renyi p (AppendixB.subsets k r) (fun x => 1) (AppendixB.shuffle k r q) -
                      (Real.log ↑(k.choose r) - 2 * p * (1 - t) / (t * ↑r * ↑k ^ 2))| ≤
                  C / (↑k ^ 2 * √↑k)
AntisymmetricVerification.antisymmetricChannel_bell_entropy {k r : ℕ} (hkr : 2 * (r + 1) ≤ k) (p : ℝ) (hp : 0 < p)
  (t : ℝ) :
  RevisionMatrixEntropy.matrixRenyiEntropy p
      (RevisionBell.tensorMap (⇑AntisymmetricVerification.antisymmetricChannel)
        (ProjectionChannels.conjugateMap ⇑AntisymmetricVerification.antisymmetricChannel)
        (RevisionBell.isotropic (Fin k) (AppendixB.rkt k t))) =
    AppendixB.renyi p (Finset.range (r + 2)) (AppendixB.dm k) (AppendixB.bellNu k (r + 1) t)
AntisymmetricVerification.antisymmetricChannel_bell_entropy_asymptotics {t p : ℝ} (ht0 : 0 < t) (ht1 : t < 1)
  (hp : 0 < p) (r : ℕ) :
  ∃ C k₀,
    ∀ (k : ℕ),
      k₀ ≤ ↑k →
        |RevisionMatrixEntropy.matrixRenyiEntropy p
                (RevisionBell.tensorMap (⇑AntisymmetricVerification.antisymmetricChannel)
                  (ProjectionChannels.conjugateMap ⇑AntisymmetricVerification.antisymmetricChannel)
                  (RevisionBell.isotropic (Fin k) (AppendixB.rkt k t))) -
              (2 * Real.log ↑(k.choose (r + 1)) - AppendixB.Bpr p (↑r + 1) ((1 - t) / t) / ↑k ^ 2)| ≤
          C / ↑k ^ 3
AppendixB.bell_output {t p : ℝ} (ht0 : 0 < t) (ht1 : t < 1) (hp : 0 < p) (r : ℕ) (hr : 1 ≤ r) :
  ∃ C k₀,
    ∀ (k : ℕ),
      k₀ ≤ ↑k →
        |AppendixB.renyi p (Finset.range (r + 1)) (AppendixB.dm k) (AppendixB.bellNu k r t) -
              (2 * Real.log ↑(k.choose r) - AppendixB.Bpr p (↑r) ((1 - t) / t) / ↑k ^ 2)| ≤
          C / ↑k ^ 3
AppendixB.bell_output_r1 {t p : ℝ} (ht0 : 0 < t) (ht1 : t < 1) (hp : 0 < p) :
  ∃ C k₀,
    ∀ (k : ℕ),
      k₀ ≤ ↑k →
        |AppendixB.renyi p Finset.univ ![1, ↑k ^ 2 - 1] ![AppendixB.alphaB k t, AppendixB.betaB k t] -
              (2 * Real.log ↑k - AppendixB.Ap p t / ↑k ^ 2)| ≤
          C / ↑k ^ 4
RevisionMain.theorem_I_1 (hStrong : ProjectionChannels.Canonical.CanonicalStrongInput) (p : ℝ) (hp : 0 < p) :
  ∃ k N,
    20 ≤ k ∧
      ∃ Φ,
        (ProjectionChannelsCP.CompletelyPositive Φ ∧ ProjectionChannelsCP.TracePreserving Φ) ∧
          (ProjectionChannelsCP.CompletelyPositive (AntisymmetricVerification.conjugateLinearMap Φ) ∧
              ProjectionChannelsCP.TracePreserving (AntisymmetricVerification.conjugateLinearMap Φ)) ∧
            RevisionMatrixEntropy.minimumOutputEntropy p
                (RevisionBell.tensorMap (⇑Φ) (ProjectionChannels.conjugateMap ⇑Φ)) <
              RevisionMatrixEntropy.minimumOutputEntropy p ⇑Φ +
                RevisionMatrixEntropy.minimumOutputEntropy p (ProjectionChannels.conjugateMap ⇑Φ)
AppendixB.main_coefficient_strict (p : ℝ) (hp : 0 < p) : 300 * p < AppendixB.Bpr p 5 375
ProjectionChannels.Canonical.finiteEvaluation_measurePreserving (k : ℕ) (s : Finset ℕ) :
  MeasureTheory.MeasurePreserving (⇑(ProjectionChannels.Canonical.finiteEvaluation k s))
    (ProjectionChannels.Canonical.probability k) (MeasureTheory.Measure.pi fun n => HaarProjection.unitaryHaar)
ProjectionChannels.Canonical.projection_haar_law (k : ℕ) (t : ℝ) (n : ℕ) :
  MeasureTheory.Measure.map (fun ω => ProjectionChannels.Canonical.projection k t ω n)
      (ProjectionChannels.Canonical.probability k) =
    HaarProjection.haarProjectionLaw (ProjectionChannels.Canonical.baseProjection k t n)
ProjectionChannels.Canonical.projection_rank {k : ℕ} {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
  (ω : ProjectionChannels.Canonical.Sample k) (n : ℕ) :
  (ProjectionChannels.Canonical.projection k t ω n).rank = ProjectionChannels.Canonical.rankSequence k t n
ProjectionChannels.Canonical.rank_density_tendsto {k : ℕ} {t : ℝ} (hk : 0 < k) (ht : 0 ≤ t) :
  Filter.Tendsto (fun n => ↑(ProjectionChannels.Canonical.rankSequence k t n) / (↑k * (↑n + 1))) Filter.atTop (nhds t)
RevisionMatrixEntropy.proposition_VI_1 :
  477 / 1000000 <
    2 * sInf (RevisionMatrixEntropy.matrixRenyiEntropy 1 '' RevisionOutput.spectralBody 182 ProjectionChannels.K182.t) -
      RevisionMatrixEntropy.matrixRenyiEntropy 1
        (RevisionBell.isotropic (Fin 182) (BellLimitVerification.mixing 182 ProjectionChannels.K182.t))
RevisionMatrixEntropy.proposition_VI_1_body :
  477 / 1000000 <
    2 * sInf (RevisionMatrixEntropy.matrixRenyiEntropy 1 '' RevisionOutput.spectralBody 182 ProjectionChannels.K182.t) -
      ProjectionChannels.K182.bellEntropy
RevisionMatrixEntropy.eventual_nonadditivity_182.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω)
  (P : Ω → (N : ℕ) → Matrix (Fin (N + 1) × Fin 182) (Fin (N + 1) × Fin 182) ℂ)
  (hH : ∀ (ω : Ω) (N : ℕ), (P ω N).IsHermitian) (hId : ∀ (ω : Ω) (N : ℕ), P ω N * P ω N = P ω N)
  (hStrong : ProjectionChannels.FullBlockModifiedStrongInput μ 182 ProjectionChannels.K182.t P hH) :
  let Φ := fun ω N => RevisionOutput.normalizedOutput (P ω N) (RevisionOutput.marginalNormalizer (P ω N) ⋯);
  ∀ᵐ (ω : Ω) ∂μ,
    ∀ᶠ (N : ℕ) in Filter.atTop,
      477 / 1000000 <
        RevisionMatrixEntropy.minimumOutputEntropy 1 (Φ ω N) +
            RevisionMatrixEntropy.minimumOutputEntropy 1 (ProjectionChannels.conjugateMap (Φ ω N)) -
          RevisionMatrixEntropy.minimumOutputEntropy 1
            (RevisionBell.tensorMap (Φ ω N) (ProjectionChannels.conjugateMap (Φ ω N)))
ProjectionChannels.RevisionK182.certified_entropy_gap_182 {v : Fin 182 → ℝ}
  (hv : v ∈ ProjectionChannels.K182.normalizedFeasible) :
  477 / 1000000 < 2 * ProjectionChannels.finiteShannon v - ProjectionChannels.K182.bellEntropy
ProjectionChannels.K182.certified_entropy_gap :
  477 / 1000000 < 2 * ProjectionChannels.K182.entropyLower - ProjectionChannels.K182.bellEntropy
ProjectionChannels.RevisionK182.lemma_C1_minimizer_shape {k : ℕ} (hk : 2 ≤ k) {t : ℝ} (htlo : 1 / (↑k * (↑k - 1)) < t)
  (hthi : t < 1 - 1 / ↑k) (hbar : (√(t * (1 - 1 / ↑k)) + √((1 - t) / ↑k)) ^ 2 < 1 / 4) {v : Fin k → ℝ}
  (hv : v ∈ AppendixB.Lam k t) (hmin : IsMinOn ProjectionChannels.finiteShannon (AppendixB.Lam k t) v) :
  ∃ i x, 1 / ↑k < x ∧ x < 1 ∧ ∀ (j : Fin k), v j = if j = i then x else (1 - x) / (↑k - 1)
ProjectionChannels.RevisionK182.lemma_C1_entropy_minimum {k : ℕ} (hk : 2 ≤ k) {t : ℝ} (htlo : 1 / (↑k * (↑k - 1)) < t)
  (hthi : t < 1 - 1 / ↑k) (hbar : (√(t * (1 - 1 / ↑k)) + √((1 - t) / ↑k)) ^ 2 < 1 / 4) (i : Fin k) :
  IsLeast (ProjectionChannels.finiteShannon '' AppendixB.Lam k t)
      (ProjectionChannels.oneHighEntropy k (ProjectionChannels.RevisionK182.largestCoordinate k t i)) ∧
    ∀ (L : ℝ),
      ProjectionChannels.RevisionK182.largestCoordinate k t i ≤ L →
        L ≤ 1 → ∀ v ∈ AppendixB.Lam k t, ProjectionChannels.oneHighEntropy k L ≤ ProjectionChannels.finiteShannon v
ProjectionChannels.RevisionK182.hasOneHighEntropyMinimizer_182 :
  ProjectionChannels.HasOneHighEntropyMinimizer ProjectionChannels.K182.normalizedFeasible
ProjectionChannels.ScalarCertificate.q_paper_formula (t a z : ℝ) :
  ProjectionChannels.K182.q t a z = (a - z + √(a ^ 2 - 2 * a * z * (1 - 2 * t) + z ^ 2)) / 2
ProjectionChannels.ScalarCertificate.coordinate_le_mul_sum {k : ℕ} {t L z : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1) (hz : 0 ≤ z)
  (hU : ProjectionChannels.ScalarCertificate.upperBound k t L z ≤ 0) {u : Fin k → ℝ} (hu : u ∈ AppendixB.Dset k t)
  (i : Fin k) : u i ≤ L * ∑ j, u j
ProjectionChannels.ScalarCertificate.lemma_C2 {k : ℕ} {t L z : ℝ} (hk : 0 < k) (ht0 : 0 ≤ t) (ht1 : t ≤ 1)
  (hthreshold : 1 < ↑k ^ 2 * t) (hz : 0 ≤ z) (hU : ProjectionChannels.ScalarCertificate.upperBound k t L z ≤ 0)
  {lam : Fin k → ℝ} (hlam : lam ∈ AppendixB.Lam k t) (i : Fin k) : lam i ≤ L
ProjectionChannels.ScalarCertificate.lemma_C2_largestEigenvalue {k : ℕ} {t L z : ℝ} (hk : 0 < k) (ht0 : 0 ≤ t)
  (ht1 : t ≤ 1) (hthreshold : 1 < ↑k ^ 2 * t) (hz : 0 ≤ z)
  (hU : ProjectionChannels.ScalarCertificate.upperBound k t L z ≤ 0) :
  ProjectionChannels.ScalarCertificate.largestEigenvalue k t ≤ L
