RevisionMain.theorem_V_1_fixed_k.{u_1} {Ω : Type u_1} [MeasurableSpace Ω] (μ : MeasureTheory.Measure Ω) {k : ℕ}
  [NeZero k] {t : ℝ} (hk : 0 < k) (ht0 : 0 < t) (ht1 : t < 1) (hkt : 1 < ↑k ^ 2 * t) (r : ℕ) (hrk : r + 1 ≤ k)
  (P : Ω → (n : ℕ) → Matrix (Fin (n + 1) × Fin k) (Fin (n + 1) × Fin k) ℂ) (hH : ∀ (ω : Ω) (n : ℕ), (P ω n).IsHermitian)
  (hId : ∀ (ω : Ω) (n : ℕ), P ω n * P ω n = P ω n) (hFull : ProjectionChannels.FullBlockModifiedStrongInput μ k t P hH)
  (p : ℝ) (hp : 0 < p) :
  let Θ := fun ω n => RevisionMain.antisymmetricNormalizedChannel r (P ω n) ⋯;
  ∀ᵐ (ω : Ω) ∂μ,
    Filter.Tendsto (fun n => RevisionMatrixEntropy.minimumOutputEntropy p ⇑(Θ ω n)) Filter.atTop
        (nhds (AppendixB.infimumOutputEntropy p t k (r + 1))) ∧
      Filter.Tendsto
        (fun n =>
          RevisionMatrixEntropy.matrixRenyiEntropy p
            (RevisionBell.tensorMap (⇑(Θ ω n)) (ProjectionChannels.conjugateMap ⇑(Θ ω n))
              (RevisionBell.bellState (Fin (n + 1)))))
        Filter.atTop (nhds (RevisionMatrixEntropy.matrixRenyiEntropy p (RevisionMain.antisymmetricBellLimit k r t)))
RevisionMain.theorem_V_1_single_asymptotics {t p : ℝ} (ht0 : 0 < t) (ht1 : t < 1) (hp : 0 < p) (r : ℕ) :
  ∃ C,
    0 ≤ C ∧
      ∃ k₀,
        ∀ (k : ℕ),
          k₀ ≤ ↑k →
            r + 1 ≤ k ∧
              |sInf
                      ((fun M =>
                          RevisionMatrixEntropy.matrixRenyiEntropy p
                            (AntisymmetricVerification.antisymmetricChannel M)) ''
                        RevisionOutput.spectralBody k t) -
                    (Real.log ↑(k.choose (r + 1)) - 2 * p * (1 - t) / (t * (↑r + 1) * ↑k ^ 2))| ≤
                C / (↑k ^ 2 * √↑k)
RevisionMain.theorem_V_1_bell_asymptotics {t p : ℝ} (ht0 : 0 < t) (ht1 : t < 1) (hp : 0 < p) (r : ℕ) :
  ∃ C k₀,
    ∀ (k : ℕ),
      k₀ ≤ ↑k →
        |RevisionMatrixEntropy.matrixRenyiEntropy p (RevisionMain.antisymmetricBellLimit k r t) -
              (2 * Real.log ↑(k.choose (r + 1)) - AppendixB.Bpr p (↑r + 1) ((1 - t) / t) / ↑k ^ 2)| ≤
          C / ↑k ^ 3
RevisionMain.theorem_I_1 (hStrong : ProjectionChannels.Canonical.CanonicalStrongInput) (p : ℝ) (hp : 0 < p) :
  ∃ k N,
    20 ≤ k ∧
      ∃ Φ,
        (ProjectionChannelsCP.CompletelyPositive Φ ∧ ProjectionChannelsCP.TracePreserving Φ) ∧
          (ProjectionChannelsCP.CompletelyPositive (AntisymmetricVerification.conjugateLinearMap Φ) ∧
              ProjectionChannelsCP.TracePreserving (AntisymmetricVerification.conjugateLinearMap Φ)) ∧
            RevisionMatrixEntropy.minimumOutputEntropy p
                (RevisionBell.tensorMap (⇑Φ) (ProjectionChannels.conjugateMap ⇑Φ)) <
              RevisionMatrixEntropy.minimumOutputEntropy p ⇑Φ +
                RevisionMatrixEntropy.minimumOutputEntropy p (ProjectionChannels.conjugateMap ⇑Φ)
