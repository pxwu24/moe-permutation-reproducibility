'RevisionMatrixEntropy.matrixRenyiEntropy_continuousOn' depends on axioms: [propext, Classical.choice, Quot.sound]
'RevisionMatrixEntropy.matrixRenyiEntropy_uniformContinuousOn' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
'RevisionMatrixEntropy.matrixRenyiEntropy_eq_eigenvalues' depends on axioms: [propext, Classical.choice, Quot.sound]
'RevisionMatrixEntropy.minimumOutputEntropy_conjugateMap' depends on axioms: [propext, Classical.choice, Quot.sound]
'RevisionMatrixEntropy.matrixRenyiEntropy_isotropic' depends on axioms: [propext, Classical.choice, Quot.sound]
RevisionMatrixEntropy.matrixRenyiEntropy_continuousOn.{u_1} {A : Type u_1} [Fintype A] [DecidableEq A] [Nonempty A]
  (p : ℝ) (hp : 0 < p) : ContinuousOn (RevisionMatrixEntropy.matrixRenyiEntropy p) (RevisionOutput.densityMatrices A)
RevisionMatrixEntropy.minimumOutputEntropy_conjugateMap.{u_1, u_2} {A : Type u_1} {B : Type u_2} [Fintype A]
  [DecidableEq A] [Fintype B] [DecidableEq B] [Nonempty A] (p : ℝ) (hp : 0 < p) (Φ : Matrix A A ℂ → Matrix B B ℂ)
  (hΦ : ∀ ρ ∈ RevisionOutput.densityMatrices A, (Φ ρ).IsHermitian) :
  RevisionMatrixEntropy.minimumOutputEntropy p (ProjectionChannels.conjugateMap Φ) =
    RevisionMatrixEntropy.minimumOutputEntropy p Φ
RevisionMatrixEntropy.matrixRenyiEntropy_isotropic {A : Type} [Fintype A] [DecidableEq A] [Nonempty A] (p : ℝ)
  (hp : 0 < p) (r : ℝ) :
  RevisionMatrixEntropy.matrixRenyiEntropy p (RevisionBell.isotropic A r) =
    let b := (1 - r) / ↑(Fintype.card A) ^ 2;
    let a := r + b;
    if p = 1 then -(a * Real.log a + (↑(Fintype.card A) ^ 2 - 1) * (b * Real.log b))
    else Real.log (a ^ p + (↑(Fintype.card A) ^ 2 - 1) * b ^ p) / (1 - p)
